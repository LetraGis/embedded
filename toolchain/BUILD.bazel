load(":cc_toolchain_config.bzl", "cc_toolchain_config")
load("@rules_cc//cc:defs.bzl", "cc_toolchain")

package(default_visibility = ["//visibility:public"])

filegroup(name = "empty")

# Instantiate the configuration rule
cc_toolchain_config(name = "arm_gcc_config")

# Package everything into a C++ toolchain wrapper
cc_toolchain(
    name = "arm_gcc_cc_toolchain",
    all_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    toolchain_config = ":arm_gcc_config",
)

# Bind the toolchain strictly to bare-metal architectures
toolchain(
    name = "arm_gcc_toolchain",
    exec_compatible_with = [],
    target_compatible_with = [
        "@platforms//os:none",
    ],
    toolchain = ":arm_gcc_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

# Define the actual target platform representing your STM32 hardware
platform(
    name = "stm32f4_platform",
    constraint_values = [
        "@platforms//cpu:armv7e-m",   # Cortex-M4 fits the ARMv7-M architecture profile
        "@platforms//os:none",        # Bare-metal
    ],
)
